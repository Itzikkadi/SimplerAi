# DeepSeek API key — https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Freesound API key — https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=...

# Server port
PORT=8787

# SQLite database path (auto-created on first run)
SQLITE_PATH=./packages/server/data/simpler.sqlite

# Web — points to the API server (no change needed for local dev)
VITE_API_URL=/api
